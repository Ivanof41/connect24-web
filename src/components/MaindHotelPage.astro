<script>
  /* ── Spotlight: glow que sigue al cursor ── */
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canHover && !prefersReducedMotion) {
    let ticking = false;
    document.querySelectorAll<HTMLElement>('.spotlight').forEach(el => {
      el.addEventListener('mousemove', (e: MouseEvent) => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const rect = el.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          el.style.setProperty('--sx', `${x}%`);
          el.style.setProperty('--sy', `${y}%`);
          ticking = false;
        });
      });
    });
  }

  /* ── Contador animado en las cifras del hero ── */
  function formatLike(template: string, n: number) {
    const sign = template.match(/^[+\-]/)?.[0] ?? '';
    const sep = template.includes('.') ? '.' : template.includes(',') ? ',' : '';
    let digits = Math.round(n).toString();
    if (sep) digits = digits.replace(/\B(?=(\d{3})+(?!\d))/g, sep);
    return sign + digits;
  }

  if (!prefersReducedMotion) {
    const counters = document.querySelectorAll<HTMLElement>('.mh-count');
    const countObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        countObserver.unobserve(el);

        const target = el.textContent?.trim() ?? '';
        const value = parseInt(target.replace(/[^\d]/g, ''), 10);
        if (!value) return;

        const duration = 1300;
        const start = performance.now();
        function tick(now: number) {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = formatLike(target, value * eased);
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = target;
        }
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    counters.forEach(el => countObserver.observe(el));
  }
</script>
