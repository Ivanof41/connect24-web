---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import type { Translations } from '../i18n/es';

interface Props {
  t: Translations;
  lang: string;
}
const { t, lang } = Astro.props;
const tmh = t.maindhotel;
---
<Layout title={tmh.page_title} description={tmh.page_desc}>
  <Nav t={t.nav} lang={lang} />

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="mh-hero">
    <div class="mh-hero-inner">

      <div class="mh-hero-content">
        <div class="mh-tags">
          {tmh.hero_tags.map((s: string) => <span>{s}</span>)}
        </div>

        <h1 class="mh-hero-title">
          <span class="mh-ht-normal">{tmh.hero_title1}</span>
          <span class="mh-ht-accent">{tmh.hero_title2}</span>
        </h1>

        <p class="mh-hero-sub" set:html={tmh.hero_sub} />
        <p class="mh-hero-tagline">
          <span class="mh-flake">✳</span>
          {tmh.hero_tagline_pre} <strong>{tmh.hero_tagline_connect}</strong>{tmh.hero_tagline_mid} <strong class="accent">{tmh.hero_tagline_decide}</strong>.
        </p>

        <div class="mh-hero-actions">
          <a href="#contacto" class="btn btn-primary">{tmh.hero_btn_info}</a>
          <a href="#como-funciona" class="btn btn-ghost">{tmh.hero_btn_how}</a>
        </div>
      </div>

      <div class="mh-hero-visual" aria-hidden="true">
        <div class="mh-stage">
          <div class="mh-hero-glow" aria-hidden="true"></div>
          <svg class="mh-conn" viewBox="0 0 640 340" preserveAspectRatio="none">
            <path class="mh-cl mh-cl1" d="M175,85 Q260,85 308,170"  fill="none" stroke="#45bfa2" stroke-width="1.5" stroke-dasharray="6 6"/>
            <path class="mh-cl mh-cl2" d="M175,255 Q260,255 308,170" fill="none" stroke="#45bfa2" stroke-width="1.5" stroke-dasharray="6 6"/>
            <path class="mh-cl mh-cl3" d="M465,85 Q380,85 332,170"  fill="none" stroke="#003c5b" stroke-width="1.5" stroke-dasharray="6 6"/>
            <path class="mh-cl mh-cl4" d="M465,255 Q380,255 332,170" fill="none" stroke="#003c5b" stroke-width="1.5" stroke-dasharray="6 6"/>

            <circle class="mh-packet" r="3">
              <animateMotion dur="2.4s" begin="0s" repeatCount="indefinite" path="M175,85 Q260,85 308,170"/>
            </circle>
            <circle class="mh-packet" r="3">
              <animateMotion dur="2.8s" begin="0.6s" repeatCount="indefinite" path="M175,255 Q260,255 308,170"/>
            </circle>
            <circle class="mh-packet" r="3">
              <animateMotion dur="2.2s" begin="1.1s" repeatCount="indefinite" path="M465,85 Q380,85 332,170"/>
            </circle>
            <circle class="mh-packet" r="3">
              <animateMotion dur="3s" begin="0.3s" repeatCount="indefinite" path="M465,255 Q380,255 332,170"/>
            </circle>
          </svg>

          <div class="mh-cards-col mh-cards-left">
            <div class="mh-stat-card mh-stat--a">
              <div class="mh-stat-val mh-count">{tmh.hero_m1_val}</div>
              <div class="mh-stat-label">{tmh.hero_m1_label}</div>
            </div>
            <div class="mh-stat-card mh-stat--b">
              <div class="mh-stat-val mh-count">{tmh.hero_m2_val}</div>
              <div class="mh-stat-label">{tmh.hero_m2_label}</div>
            </div>
          </div>

          <div class="mh-badge-center">
            <img src="/maindhotel_icono.svg" alt="MaindHotel" class="mh-icon-hero" />
            <img src="/maindhotel_solotexto.svg" alt="MaindHotel" class="mh-wordmark-hero" />
          </div>

          <div class="mh-cards-col mh-cards-right">
            <div class="mh-stat-card mh-stat--b">
              <div class="mh-stat-val mh-count">{tmh.hero_m3_val}</div>
              <div class="mh-stat-label">{tmh.hero_m3_label}</div>
            </div>
            <div class="mh-stat-card mh-stat--a">
              <div class="mh-stat-val mh-count">{tmh.hero_m4_val}</div>
              <div class="mh-stat-label">{tmh.hero_m4_label}</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CONECTAR + DECIDIR = ACTUAR
  ═══════════════════════════════════════════════ -->
  <section class="mh-features" id="como-funciona">
    <div class="container mh-features-inner">

      <div class="mh-features-left reveal">
        <span class="eyebrow">{tmh.feat_eyebrow}</span>
        <h2>{tmh.feat_title1}<br/>{tmh.feat_title2}</h2>
        <p class="section-desc" set:html={tmh.feat_desc} />

        <ul class="mh-checklist">
          {tmh.feat_items.map((item: string) => (
            <li><span class="mh-check">✓</span>{item}</li>
          ))}
        </ul>
        <p class="mh-footnote">{tmh.feat_footnote}</p>
      </div>

      <div class="mh-features-right reveal reveal-delay-2">
        <div class="mh-flow">
          <div class="mh-flow-node spotlight">
            <div class="mh-flow-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="5" cy="12" r="2.2"/><circle cx="19" cy="6" r="2.2"/><circle cx="19" cy="18" r="2.2"/>
                <path d="M7 11l10-4M7 13l10 4"/>
              </svg>
            </div>
            <div class="mh-flow-title">{tmh.flow_node1_title}</div>
            <p class="mh-flow-desc">{tmh.flow_node1_desc}</p>
          </div>

          <div class="mh-flow-op">+</div>

          <div class="mh-flow-node spotlight">
            <div class="mh-flow-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="7" y="7" width="10" height="10" rx="2"/>
                <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.5 4.5l2 2M17.5 4.5l-2 2M4.5 19.5l2-2M17.5 19.5l-2-2"/>
              </svg>
            </div>
            <div class="mh-flow-title">{tmh.flow_node2_title}</div>
            <p class="mh-flow-desc">{tmh.flow_node2_desc}</p>
          </div>

          <div class="mh-flow-op">=</div>

          <div class="mh-flow-node mh-flow-node--result spotlight">
            <div class="mh-flow-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M8 12.5l2.5 2.5L16 9.5"/>
              </svg>
            </div>
            <div class="mh-flow-title">{tmh.flow_node3_title}</div>
            <p class="mh-flow-desc">{tmh.flow_node3_desc}</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       ECOSISTEMA DE INTEGRACIONES
  ═══════════════════════════════════════════════ -->
  <section class="mh-integrations">
    <div class="container">
      <div class="mh-integ-header reveal">
        <span class="eyebrow">{tmh.integ_eyebrow}</span>
        <h2>{tmh.integ_title}</h2>
        <p class="section-desc" style="margin: 0 auto 3rem;">{tmh.integ_desc}</p>
      </div>

      <div class="mh-integ-group reveal reveal-delay-1">
        <span class="mh-integ-label">{tmh.integ_protocols_label}</span>
        <div class="mh-integ-grid">
          {tmh.integ_protocols.map((name: string) => (
            <div class="mh-integ-badge">{name}</div>
          ))}
        </div>
      </div>

      <div class="mh-integ-group reveal reveal-delay-2">
        <span class="mh-integ-label">{tmh.integ_systems_label}</span>
        <div class="mh-integ-grid">
          {tmh.integ_systems.map((name: string) => (
            <div class="mh-integ-badge mh-integ-badge--alt">{name}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CONOCIMIENTO
  ═══════════════════════════════════════════════ -->
  <section class="mh-knowledge">
    <div class="container">
      <div class="mh-know-panel reveal">
        <div class="mh-know-text">
          <span class="eyebrow mh-know-eyebrow">{tmh.know_eyebrow}</span>
          <p class="mh-know-big">{tmh.know_title1}<br/>{tmh.know_title2}</p>
          <p class="mh-know-sub">{tmh.know_desc}</p>
          <ul class="mh-know-categories">
            {tmh.know_categories.map((c: string) => (
              <li><span class="mh-dot"></span>{c}</li>
            ))}
          </ul>
        </div>
        <div class="mh-know-cards">
          <div class="mh-know-card">
            <span class="mh-know-card-title">{tmh.know_ia_title}</span>
            <p>{tmh.know_ia_desc}</p>
          </div>
          <div class="mh-know-card">
            <span class="mh-know-card-title">{tmh.know_book_title}</span>
            <p>{tmh.know_book_desc}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       ¿POR DÓNDE EMPEZAMOS?
  ═══════════════════════════════════════════════ -->
  <section class="mh-roadmap" id="roadmap">
    <div class="container">
      <div class="mh-roadmap-header reveal">
        <span class="eyebrow">{tmh.roadmap_eyebrow}</span>
        <h2>{tmh.roadmap_title1}<br/>{tmh.roadmap_title2}</h2>
        <p class="section-desc" style="margin: 0 auto 3.5rem;">{tmh.roadmap_desc}</p>
      </div>

      <div class="mh-roadmap-steps reveal reveal-delay-1">

        <div class="mh-step spotlight">
          <div class="mh-step-num">{tmh.roadmap_step1_num}</div>
          <div class="mh-step-body">
            <h3>{tmh.roadmap_step1_title}</h3>
            <ul class="mh-step-grid">
              {tmh.roadmap_step1_items.map((item: string) => (
                <li><span class="mh-step-dot"></span>{item}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mh-step mh-step--mid spotlight">
          <div class="mh-step-num">{tmh.roadmap_step2_num}</div>
          <div class="mh-step-body">
            <h3>{tmh.roadmap_step2_title}</h3>
            <p class="mh-step-desc" set:html={tmh.roadmap_step2_desc} />
          </div>
        </div>

        <div class="mh-step spotlight">
          <div class="mh-step-num">{tmh.roadmap_step3_num}</div>
          <div class="mh-step-body">
            <h3>{tmh.roadmap_step3_title}</h3>
            <ul class="mh-step-grid">
              {tmh.roadmap_step3_items.map((item: string) => (
                <li><span class="mh-step-dot"></span>{item}</li>
              ))}
            </ul>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       BENEFICIOS
  ═══════════════════════════════════════════════ -->
  <section class="mh-benefits">
    <div class="container mh-benefits-grid reveal">
      <div class="mh-benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
        <span>{tmh.benefit1}</span>
      </div>
      <div class="mh-benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/></svg>
        <span>{tmh.benefit2}</span>
      </div>
      <div class="mh-benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.4.3.5.8.5 1.3v.3h6v-.3c0-.5.1-1 .5-1.3A6 6 0 0 0 12 3z"/></svg>
        <span>{tmh.benefit3}</span>
      </div>
      <div class="mh-benefit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 14c1 1 2.2 1.5 3.5 1.5s2.5-.5 3.5-1.5M9 10h.01M15 10h.01"/></svg>
        <span>{tmh.benefit4}</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CTA FINAL
  ═══════════════════════════════════════════════ -->
  <section class="mh-cta" id="contacto">
    <div class="container mh-cta-inner">
      <div class="mh-cta-text reveal">
        <h2 class="mh-cta-title">{tmh.cta_title}</h2>
        <p class="mh-cta-sub">{tmh.cta_sub}</p>
        <div class="mh-cta-contact">
          <a href="tel:+34871153883" class="mh-cta-link">+34 871 153 883</a>
          <span class="mh-cta-sep">|</span>
          <a href="mailto:info@connect24.io" class="mh-cta-link">info@connect24.io</a>
        </div>
        <a href="mailto:info@connect24.io" class="btn btn-white mh-cta-btn">{tmh.cta_btn}</a>
      </div>

      <div class="mh-cta-badge reveal reveal-delay-2" aria-hidden="true">
        <img src="/maindhotel_icono.svg" alt="MaindHotel" class="mh-cta-icon" />
        <img src="/maindhotel_solotexto.svg" alt="MaindHotel" class="mh-cta-wordmark" />
        <p class="mh-cta-distinction" set:html={tmh.cta_distinction} />
      </div>
    </div>
  </section>
</Layout>

<style>
/* ═══════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════ */
.mh-hero {
  min-height: 100vh;
  display: flex; align-items: center;
  padding: 9rem 2rem 6rem;
  background: linear-gradient(135deg, #e9eff2 0%, #d5e2e7 55%, #e9eff2 100%);
  position: relative; overflow: hidden;
}
:global([data-theme="dark"]) .mh-hero {
  background: linear-gradient(135deg, #080F18 0%, #0a1520 55%, #080F18 100%);
}
.mh-hero::before {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 55% 70% at 75% 50%, rgba(255,255,255,0.85) 0%, transparent 70%),
    radial-gradient(ellipse 30% 50% at 20% 60%, rgba(0,60,91,0.10) 0%, transparent 65%);
}
:global([data-theme="dark"]) .mh-hero::before {
  background:
    radial-gradient(ellipse 45% 65% at 75% 50%, rgba(69,191,162,0.18) 0%, transparent 70%),
    radial-gradient(ellipse 30% 50% at 20% 60%, rgba(0,60,91,0.30) 0%, transparent 65%);
}
.mh-hero::after {
  content: '';
  position: absolute; inset: -20%; pointer-events: none;
  background:
    radial-gradient(circle at 30% 35%, rgba(0,60,91,0.14) 0%, transparent 45%),
    radial-gradient(circle at 70% 60%, rgba(69,191,162,0.16) 0%, transparent 50%),
    radial-gradient(circle at 50% 15%, rgba(0,60,91,0.10) 0%, transparent 40%);
  filter: blur(50px);
  animation: mhMeshDrift 20s ease-in-out infinite alternate;
  will-change: transform;
}
:global([data-theme="dark"]) .mh-hero::after {
  background:
    radial-gradient(circle at 30% 35%, rgba(69,191,162,0.26) 0%, transparent 45%),
    radial-gradient(circle at 70% 60%, rgba(69,191,162,0.16) 0%, transparent 50%),
    radial-gradient(circle at 50% 15%, rgba(0,60,91,0.35) 0%, transparent 40%);
}
@keyframes mhMeshDrift {
  0%   { transform: translate(0, 0) scale(1); }
  50%  { transform: translate(-2%, 2%) scale(1.08); }
  100% { transform: translate(2%, -2%) scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .mh-hero::after { animation: none; }
}
.mh-hero-inner {
  position: relative; z-index: 1;
  max-width: 1200px; margin: 0 auto; width: 100%;
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 4rem; align-items: center;
}
.mh-hero-content { position: relative; z-index: 2; }
.mh-tags {
  display: flex; flex-wrap: wrap; gap: 0.5rem;
  margin-bottom: 1.75rem;
}
.mh-tags span {
  font-size: 0.7rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  padding: 0.3rem 0.8rem; border-radius: var(--radius-pill);
  background: rgba(69,191,162,0.12); color: var(--c24-teal-dark);
  border: 1px solid rgba(69,191,162,0.25);
}
.mh-hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 4.5vw, 4.2rem);
  font-weight: 700; line-height: 1.1;
  letter-spacing: -0.02em; margin-bottom: 1.5rem;
}
.mh-ht-normal { display: block; color: var(--c24-navy); }
:global([data-theme="dark"]) .mh-ht-normal { color: #fff; }
.mh-ht-accent { display: block; color: var(--c24-teal); }
.mh-hero-sub {
  font-size: 1rem; color: var(--c24-text-muted);
  line-height: 1.8; font-weight: 300; max-width: 460px;
  margin-bottom: 0.75rem;
}
:global(.mh-hero-sub strong) { color: var(--c24-text); font-weight: 600; }
.mh-hero-tagline {
  font-size: 0.9rem; color: var(--c24-text-muted);
  font-weight: 300; margin-bottom: 2rem;
  display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
}
.mh-hero-tagline strong { font-weight: 600; }
.mh-hero-tagline strong.accent { color: var(--c24-teal); }
.mh-flake { color: var(--c24-teal); font-size: 1rem; }
.mh-hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
.mh-hero-visual { display: flex; justify-content: center; align-items: center; }

/* ── Stage ── */
.mh-stage {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 340px;
}
.mh-cards-left  { margin-right: 45px; }
.mh-cards-right { margin-left: 45px; }

/* Luz blanca detrás del logo */
.mh-hero-glow {
  position: absolute;
  top: 50%; left: 50%;
  width: 165vmax; height: 165vmax;
  transform: translate(-50%, -50%) scale(0.92);
  background: radial-gradient(circle,
    rgba(255,255,255,1) 0%,
    rgba(255,255,255,0.9) 12%,
    rgba(255,255,255,0.65) 28%,
    rgba(255,255,255,0.42) 45%,
    rgba(255,255,255,0.24) 62%,
    rgba(255,255,255,0.10) 78%,
    rgba(255,255,255,0.03) 92%,
    rgba(255,255,255,0) 100%);
  border-radius: 50%;
  pointer-events: none;
  animation: mhGlowPulse 7s ease-in-out infinite;
}
:global([data-theme="dark"]) .mh-hero-glow {
  background: radial-gradient(circle,
    rgba(255,255,255,0.65) 0%,
    rgba(255,255,255,0.55) 12%,
    rgba(255,255,255,0.40) 28%,
    rgba(255,255,255,0.26) 45%,
    rgba(255,255,255,0.15) 62%,
    rgba(255,255,255,0.06) 78%,
    rgba(255,255,255,0.02) 92%,
    rgba(255,255,255,0) 100%);
}
@keyframes mhGlowPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(0.92); opacity: 0.85; }
  50%      { transform: translate(-50%, -50%) scale(1.06); opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .mh-hero-glow { animation: none; transform: translate(-50%, -50%) scale(1); }
}

/* SVG connectors */
.mh-conn {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  pointer-events: none; overflow: visible; opacity: 0.5;
}
.mh-cl { animation: mhConnFlow 2.4s linear infinite; }
.mh-cl1 { animation-delay: 0s; }
.mh-cl2 { animation-delay: 0.35s; }
.mh-cl3 { animation-delay: 0.18s; }
.mh-cl4 { animation-delay: 0.52s; }
:global([data-theme="dark"]) .mh-conn { opacity: 0.8; }
@keyframes mhConnFlow {
  from { stroke-dashoffset: 18; }
  to   { stroke-dashoffset: 0; }
}

/* Partículas de datos viajando por las líneas hacia el logo */
.mh-packet {
  fill: #45bfa2;
  filter: drop-shadow(0 0 4px rgba(69,191,162,0.9)) drop-shadow(0 0 8px rgba(69,191,162,0.5));
}
:global([data-theme="dark"]) .mh-packet {
  fill: #6fe0c4;
  filter: drop-shadow(0 0 5px rgba(111,224,196,1)) drop-shadow(0 0 10px rgba(111,224,196,0.6));
}
@media (prefers-reduced-motion: reduce) {
  .mh-packet { display: none; }
}

/* Cards column */
.mh-cards-col {
  display: flex; flex-direction: column;
  gap: 16px; z-index: 1; flex: 0 0 175px;
}

/* Stat cards */
.mh-stat-card {
  background: linear-gradient(150deg, #ffffff 0%, #f4f8fb 100%);
  border: 1.5px solid rgba(0,60,91,0.12);
  border-top: 1px solid rgba(255,255,255,0.95);
  border-radius: 14px; padding: 14px 16px;
  box-shadow: 0 1px 0 rgba(255,255,255,0.85) inset, 0 4px 8px rgba(0,60,91,0.06), 0 12px 28px rgba(0,60,91,0.10);
  display: flex; flex-direction: column; gap: 4px;
}
:global([data-theme="dark"]) .mh-stat-card {
  background: linear-gradient(150deg, rgba(20,38,58,0.98) 0%, rgba(12,26,42,0.95) 100%);
  border-color: rgba(69,191,162,0.16);
  border-top-color: rgba(69,191,162,0.22);
  box-shadow: 0 1px 0 rgba(69,191,162,0.12) inset, 0 4px 8px rgba(0,0,0,0.20), 0 12px 28px rgba(0,0,0,0.28);
}
.mh-stat--a { border-color: rgba(69,191,162,0.45); }
.mh-stat--b { border-color: rgba(0,60,91,0.30); }
